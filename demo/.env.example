# Copy to .env and fill in what you have. Either key is enough; the simulator needs none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: pin a Claude model, e.g. claude-sonnet-4-5
ANTHROPIC_MODEL=

# Session budget enforced by the stream policy (applied at `docker compose up`;
# after changing, run scripts/reset.sh). Lower BUDGET_USD to ~0.15 to show the
# halt quickly on stage.
BUDGET_USD=0.50
BUDGET_TOKENS=200000
