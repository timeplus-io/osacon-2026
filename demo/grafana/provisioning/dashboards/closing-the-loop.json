{
  "uid": "closing-the-loop",
  "title": "Closing the Loop \u2014 agents \u00d7 Proton",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "osacon",
    "proton"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Decisions sent back to agents (live)",
      "type": "table",
      "datasource": {
        "type": "timeplus-proton-datasource",
        "uid": "proton-ds"
      },
      "description": "Streaming query: a row appears the moment the policy decides. The agent's PreToolUse hook reads the same stream. Pushed live; last 15 min replayed on open.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "timeplus-proton-datasource",
            "uid": "proton-ds"
          },
          "refId": "A",
          "sql": "SELECT _tp_time AS time, session_id, action, reason FROM agent_actions SETTINGS seek_to='-15m'"
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Tool calls (live)",
      "type": "table",
      "datasource": {
        "type": "timeplus-proton-datasource",
        "uid": "proton-ds"
      },
      "description": "Every tool call from Claude Code, Codex, or the simulator, pushed live as it arrives (last 15 min replayed on open).",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "timeplus-proton-datasource",
            "uid": "proton-ds"
          },
          "refId": "A",
          "sql": "SELECT _tp_time AS time, agent, session_id, tool_name, call_target, success FROM agent_events WHERE event = 'tool_result' SETTINGS seek_to='-15m'"
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Alerts by detector",
      "type": "bargauge",
      "datasource": {
        "type": "timeplus-proton-datasource",
        "uid": "proton-ds"
      },
      "description": "Running totals over the last hour, pushed live (streaming global aggregation, no refresh).",
      "gridPos": {
        "x": 14,
        "y": 7,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "timeplus-proton-datasource",
            "uid": "proton-ds"
          },
          "refId": "A",
          "sql": "SELECT now64(3) AS time, count_if(detector = 'tool_loop') AS tool_loop, count_if(detector = 'tool_errors') AS tool_errors, count_if(detector = 'budget') AS budget FROM agent_alerts EMIT PERIODIC 2s SETTINGS seek_to='-1h'"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Tool calls per 5s, by agent (live)",
      "type": "timeseries",
      "datasource": {
        "type": "timeplus-proton-datasource",
        "uid": "proton-ds"
      },
      "description": "Streaming tumbling-window aggregation.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "timeplus-proton-datasource",
            "uid": "proton-ds"
          },
          "refId": "A",
          "sql": "SELECT window_end AS time, count_if(agent = 'claude-code') AS claude_code, count_if(agent = 'codex') AS codex, count_if(agent = 'simulator') AS simulator FROM tumble(agent_events, 5s) WHERE event = 'tool_result' GROUP BY window_end SETTINGS seek_to='-15m'"
        }
      ]
    },
    {
      "id": 5,
      "title": "Sessions",
      "type": "table",
      "datasource": {
        "type": "timeplus-proton-datasource",
        "uid": "proton-ds"
      },
      "description": "Spend and activity per session over the last hour, pushed live (streaming aggregation, no refresh).",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "timeplus-proton-datasource",
            "uid": "proton-ds"
          },
          "refId": "A",
          "sql": "SELECT max(_tp_time) AS last_seen, session_id, any(agent) AS agent, count_if(event = 'tool_result') AS tool_calls, count_if(event = 'tool_result' AND NOT success) AS failed_calls, sum(input_tokens + output_tokens) AS total_tokens, round(sum(cost_usd), 3) AS total_cost_usd FROM agent_events GROUP BY session_id EMIT PERIODIC 2s SETTINGS seek_to='-1h'"
        }
      ],
      "transformations": [
        {
          "id": "groupBy",
          "options": {
            "fields": {
              "session_id": {
                "operation": "groupby",
                "aggregations": []
              },
              "last_seen": {
                "operation": "aggregate",
                "aggregations": [
                  "last"
                ]
              },
              "agent": {
                "operation": "aggregate",
                "aggregations": [
                  "last"
                ]
              },
              "tool_calls": {
                "operation": "aggregate",
                "aggregations": [
                  "last"
                ]
              },
              "failed_calls": {
                "operation": "aggregate",
                "aggregations": [
                  "last"
                ]
              },
              "total_tokens": {
                "operation": "aggregate",
                "aggregations": [
                  "last"
                ]
              },
              "total_cost_usd": {
                "operation": "aggregate",
                "aggregations": [
                  "last"
                ]
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "last_seen (last)": "last_seen",
              "agent (last)": "agent",
              "tool_calls (last)": "tool_calls",
              "failed_calls (last)": "failed_calls",
              "total_tokens (last)": "total_tokens",
              "total_cost_usd (last)": "total_cost_usd"
            },
            "indexByName": {
              "session_id": 0,
              "agent (last)": 1,
              "tool_calls (last)": 2,
              "failed_calls (last)": 3,
              "total_tokens (last)": 4,
              "total_cost_usd (last)": 5,
              "last_seen (last)": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "last_seen",
                "desc": true
              }
            ]
          }
        }
      ]
    }
  ]
}
